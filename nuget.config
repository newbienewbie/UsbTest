<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- 1. 设置包目录 -->
	<config>
		<add key="globalPackagesFolder" value=".\packages" />
	</config>

	<!-- 2. 配置包源并忽略 SSL 验证 -->
	<packageSources>
		<clear />
		<!-- 清除其他配置源，确保可重复性 -->
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" disableTLSCertificateValidation="True" allowInsecureConnections="True" />
		<add key="stdunit" value="https://baget.stdunit.com/v3/index.json" disableTLSCertificateValidation="True" allowInsecureConnections="True" />
	</packageSources>
</configuration>